# Copie para .env e preencha.
# Webhook do Discord: Configurações do servidor > Integrações > Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000/xxxxxxxx

# Canal do Twish (sem #)
TWISH_CANAL=seucanal

# Opcional: id do jogador, só para o link do inventário na mensagem
TWISH_JOGADOR=0000000

# Opcional: segundos entre coletas (padrão 60)
# INTERVALO=60
